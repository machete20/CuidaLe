<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- res/layout/recordatorio_item.xml -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/fondo"
        android:gravity="center_vertical"
        android:layout_margin="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Campana"
            android:src="@drawable/recordatorio" />

        <TextView
            android:id="@+id/textoHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="06:00"
            android:textColor="#000000"
            android:textSize="28dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ibuprofeno"
            android:textColor="#000000"
            android:textSize="18dp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switchRecordatorio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/securitycheck"
            android:contentDescription="Eliminar recordatorio"
            android:layout_alignParentEnd="true"/>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>