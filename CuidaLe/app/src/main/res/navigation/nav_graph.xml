<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragmentInicioSes">
    <fragment
        android:id="@+id/fragmentInicioSes"
        android:name="com.example.cuidale.FragmentInicioSes"
        android:label="fragment_inicio_ses"
        tools:layout="@layout/fragment_inicio_ses" >
        <action
            android:id="@+id/action_fragmentInicioSes_to_fragmentRegistro"
            app:destination="@id/fragmentRegistro" />
        <action
            android:id="@+id/action_fragmentInicioSes_to_fragmentPantPrinc"
            app:destination="@id/fragmentPantPrinc" />
    </fragment>
    <fragment
        android:id="@+id/fragmentRegistro"
        android:name="com.example.cuidale.FragmentRegistro"
        android:label="fragment_registro"
        tools:layout="@layout/fragment_registro" />
    <fragment
        android:id="@+id/fragmentPantPrinc"
        android:name="com.example.cuidale.FragmentPantPrinc"
        android:label="fragment_pant_princ"
        tools:layout="@layout/fragment_pant_princ" >
        <action
            android:id="@+id/action_fragmentPantPrinc_to_fragmentMenuDesplegable"
            app:destination="@id/fragmentMenuDesplegable" />
    </fragment>
    <fragment
        android:id="@+id/fragmentMenuDesplegable"
        android:name="com.example.cuidale.FragmentMenuDesplegable"
        android:label="fragment_menu_desplegable"
        tools:layout="@layout/fragment_menu_desplegable" />
</navigation>